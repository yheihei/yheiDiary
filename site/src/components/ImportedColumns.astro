---
// EmDash's Columns renderer uses astro-portabletext directly for nested content.
// Use the EmDash wrapper so imported image and embed blocks keep their renderers.
import type { PortableTextProps } from "astro-portabletext/types";
import { PortableText } from "emdash/ui";

interface Props {
	node: {
		columns?: Array<{
			content: PortableTextProps["value"];
			width?: string;
		}>;
	};
}

const columns = Astro.props.node?.columns ?? [];
---

{columns.length > 0 && (
	<div class="emdash-columns" style={`--column-count: ${columns.length}`}>
		{columns.map((column) => (
			<div class="emdash-column" style={column.width ? `flex-basis: ${column.width}` : undefined}>
				<PortableText value={column.content} components={{ type: { columns: Astro.self } }} />
			</div>
		))}
	</div>
)}

<style>
	.emdash-columns {
		display: flex;
		gap: 2rem;
		margin: 1.5rem 0;
	}
	.emdash-column {
		flex: 1;
		min-width: 0;
	}
	@media (max-width: 768px) {
		.emdash-columns {
			flex-direction: column;
			gap: 1rem;
		}
	}
</style>
